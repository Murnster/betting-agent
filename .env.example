# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/betting_agent

# The Odds API
ODDS_API_KEY=your_odds_api_key_here
# Optional fallback keys. Each Odds API account carries its own monthly quota
# (500 on the free tier); the client rotates to the next key when one is out of
# credits, which is what keeps the NFL props loop alive through its ~564-credit
# November peak. See docs/NFL_SETUP.md §7.
ODDS_API_KEY_2=
ODDS_API_KEY_3=
# Books to price picks against, comma-separated Odds API keys. Set this to the
# book you actually bet at — an edge against a price you cannot take is not an
# edge. Empty shops every book in the response.
# PREFERRED_BOOKMAKERS=bet365
# NFL props only: ordered fallback books when the preferred book posts no prop
# markets. The Odds API carries no bet365 player props, so without this the
# props loop never produces a pick. One book prices each game (no best-of-N).
# PROP_FALLBACK_BOOKMAKERS=draftkings,fanduel
# Anytime-TD scorers: fetched (+1 credit/game); best per game on the card (PICK/LEAN)
# TD_PROPS_ENABLED=true
# TD_PROPS_PER_GAME=2
# Ladder hits (best overs / milestones on the alternate boards; 1 credit per game per market)
# LADDER_ENABLED=true
# LADDER_BANKROLL=100.0
# LADDER_MARKETS=player_receptions,player_reception_yds,player_rush_yds   # drop one to save a credit/game
# Straight overs (main-line Over on the receiving markets, at least one per game; no extra credits)
# OVERS_ENABLED=true
# OVERS_BANKROLL=100.0

# OpenWeatherMap (optional)
WEATHER_API_KEY=your_weather_api_key_here

# Ollama (Phase 2 - sentiment analysis)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1:8b

# Strategy settings (override defaults)
# MIN_EDGE_PCT=0.015
# MAX_KELLY_PCT=0.05
# MAX_BET_PCT=0.07
# STARTING_BANKROLL=1000.0

# Discord Webhook URLs (optional — per sport, per channel)
# DISCORD_WEBHOOK_NFL_PICKS=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_NFL_RESULTS=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_NBA_PICKS=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_NBA_RESULTS=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_NHL_PICKS=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_NHL_RESULTS=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_ALLTIME_RESULTS=https://discord.com/api/webhooks/...
# DISCORD_ENABLED=true

# LLM validator (optional, post-picks). AGENT_MODEL prefix selects the provider:
# gemini/<model> calls the Gemini API (needs GEMINI_API_KEY); claude/<model> runs
# the local `claude -p` CLI (needs Claude Code installed and logged in).
# AGENT_SHADOW=true records verdicts (agent_validations, pick cards, Discord)
# without changing edge, sizing, or dropping picks — flip to false only once the
# paper trade shows the verdicts add value.
# AGENT_ENABLED=true
# AGENT_MODEL=claude/sonnet
# AGENT_MODE=all           # validate every game on the card ('top' caps games per run, rest SKIPPED)
# AGENT_SHADOW=true
# AGENT_CLAUDE_WEB_SEARCH=true
# AGENT_CLAUDE_MAX_TURNS=4
# AGENT_CLAUDE_TIMEOUT=180
# AGENT_CLAUDE_MAX_CALL_USD=0.25
# AGENT_DAILY_BUDGET_USD=1.00
# AGENT_RETRIES=1          # re-try a failed/killed validator call before marking the game SKIPPED
